{
  "name": "aurora-rest-birch-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "capture": "node scripts/capture.mjs",
    "test:parity": "node --experimental-strip-types scripts/compare-source.mjs",
    "capture:shadow": "node scripts/capture-shadow.mjs",
    "capture:batch": "node scripts/capture-batch.mjs",
    "test:pine-parity": "node --experimental-strip-types scripts/compare-pine-source.mjs",
    "capture:pine": "node scripts/capture-pine.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "playwright-core": "1.56.1",
    "pngjs": "7.0.0"
  }
}
